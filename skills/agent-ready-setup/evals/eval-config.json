{
  "schema_version": 2,
  "skill": "agent-ready-setup",
  "description": "Evalúa detección de stack y bootstrap de configuración Agent Ready.",
  "test_cases": [
    {
      "id": "frontend-bootstrap-creates-assets",
      "description": "Detecta frontend y reporta assets creados desde plantilla.",
      "input": "Quiero configurar agent ready en este proyecto. Es una app React con Nordic.",
      "assertions": [
        {
          "type": "contains_any",
          "values": ["frontend", "Frontend"],
          "description": "Reporta stack frontend detectado"
        },
        {
          "type": "contains",
          "value": ".claude/settings.json",
          "description": "Reporta settings creado"
        },
        {
          "type": "contains",
          "value": ".claude/CLAUDE.md",
          "description": "Reporta CLAUDE.md creado"
        },
        {
          "type": "contains",
          "value": ".claude/rules/security.md",
          "description": "Reporta regla de seguridad creada"
        },
        {
          "type": "contains",
          "value": ".claude/agents/a11y-reviewer.md",
          "description": "Reporta agente de accesibilidad creado"
        },
        {
          "type": "contains",
          "value": ".claude/skills/component-creation/SKILL.md",
          "description": "Reporta skill de componentes con estructura preservada"
        },
        {
          "type": "contains",
          "value": ".claude/hooks/pre-tool-use.md",
          "description": "Reporta hook pre-tool creado"
        },
        {
          "type": "contains",
          "value": ".claude/commands/review-pr.md",
          "description": "Reporta comando de review creado"
        }
      ]
    },
    {
      "id": "existing-files-are-skipped",
      "description": "Conserva archivos existentes y reporta que fueron omitidos.",
      "input": "Setup agent ready. El proyecto ya tiene .claude/CLAUDE.md y .claude/rules/security.md.",
      "assertions": [
        {
          "type": "contains",
          "value": ".claude/CLAUDE.md",
          "description": "Menciona archivo existente"
        },
        {
          "type": "contains",
          "value": ".claude/rules/security.md",
          "description": "Menciona regla existente"
        },
        {
          "type": "contains_any",
          "values": ["skipped", "omitido", "omitidos", "ya existía"],
          "description": "Reporta archivos existentes como omitidos"
        }
      ]
    },
    {
      "id": "go-bootstrap-creates-assets",
      "description": "Detecta Go y reporta assets específicos creados.",
      "input": "Make this repo agent ready. It's a Go microservice.",
      "assertions": [
        {
          "type": "contains_any",
          "values": ["go", "Go"],
          "description": "Reporta stack Go detectado"
        },
        {
          "type": "contains",
          "value": ".claude/settings.json",
          "description": "Reporta settings creado"
        },
        {
          "type": "contains",
          "value": ".claude/rules/coding-style.md",
          "description": "Reporta regla de estilo creada"
        },
        {
          "type": "contains",
          "value": ".claude/rules/security.md",
          "description": "Reporta regla de seguridad creada"
        },
        {
          "type": "contains",
          "value": ".claude/mcp.json",
          "description": "Reporta configuración MCP creada"
        }
      ]
    }
  ]
}
