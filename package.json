{
  "name": "fury-groot-marketplace",
  "private": true,
  "description": "Multi-provider marketplace of skills and plugins for AI agents at Mercado Libre.",
  "scripts": {
    "create-version": "node scripts/create-version.js",
    "test": "npm run test:shell && npm run test:browser",
    "setup:browser-tests": "python3 -m venv node_modules/.browser-tests-venv && node_modules/.browser-tests-venv/bin/python -m pip install -r plugins/groot-kit/skills/agent-ready-setup/scripts/requirements-browser.txt",
    "test:browser": "node_modules/.browser-tests-venv/bin/python plugins/groot-kit/skills/agent-ready-setup/tests/browser-tools.spec.py",
    "test:shell": "bats tests/create-version.bats plugins/groot-kit/skills/agent-ready-setup/tests/bootstrap.bats plugins/groot-kit/skills/agent-ready-setup/tests/merge-instructions.bats plugins/groot-queue/tests/check-groot-queue-readiness.bats plugins/groot-queue/tests/query-kraken-user-data.bats plugins/groot-queue/tests/query-labor-share-data.bats plugins/groot-queue/tests/run-groot-queue.bats plugins/groot-queue/tests/install.bats plugins/groot-queue/tests/render-catalog.bats skill-eval-runner/tests/run-evals-env-contract.bats skill-eval-runner/tests/run-evals-assertions.bats",
    "test:e2e": "bats plugins/groot-queue/tests/setup-e2e.bats",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "bats": "1.13.0"
  }
}
