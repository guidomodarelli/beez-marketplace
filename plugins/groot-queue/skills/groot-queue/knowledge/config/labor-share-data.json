{
  "schema_version": 1,
  "api": {
    "base_url": "https://prod--shipping-users-mgmt-api.legacy.furyapps.io",
    "endpoints": {
      "execution": {
        "method": "GET",
        "path": "/management/v1/labor-share/{labor_share_id}"
      },
      "processes": {
        "method": "GET",
        "path": "/management/v1/labor-share/process/{facility_type}"
      }
    }
  },
  "network": {
    "connect_timeout_seconds": 5,
    "max_time_seconds": 15,
    "max_get_retries": 1,
    "max_response_bytes": 1048576
  },
  "limits": {
    "max_safe_integer": 9007199254740991,
    "max_identifier_length": 16,
    "max_assignments": 500,
    "max_processes": 100,
    "max_sub_processes_per_process": 100,
    "max_description_length": 200
  },
  "allowed_facility_types": [
    "WAREHOUSE",
    "SC",
    "XD"
  ]
}
