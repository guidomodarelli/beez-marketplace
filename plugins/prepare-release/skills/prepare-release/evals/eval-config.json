{
  "skill_name": "prepare-release",
  "evals": [
    {
      "id": 1,
      "prompt": "/prepare-release",
      "expected_output": "Fetches tags from master, proposes next MINOR version, and asks for confirmation",
      "assertions": [
        {
          "type": "contains_any",
          "values": ["git fetch", "git tag", "versión", "version", "master"],
          "description": "Should mention fetching tags from master"
        },
        {
          "type": "contains_any",
          "values": ["Confirmás", "confirm", "próxima versión", "next version"],
          "description": "Should ask for version confirmation"
        }
      ],
      "files": []
    },
    {
      "id": 2,
      "prompt": "quiero preparar el release",
      "expected_output": "Triggers the prepare-release skill and starts the release flow",
      "assertions": [
        {
          "type": "contains_any",
          "values": ["release", "master", "develop", "versión", "tag"],
          "description": "Should activate the release preparation flow"
        }
      ],
      "files": []
    },
    {
      "id": 3,
      "prompt": "crear release",
      "expected_output": "Triggers the prepare-release skill",
      "assertions": [
        {
          "type": "contains_any",
          "values": ["release", "rama", "branch", "PR", "master"],
          "description": "Should start the release branch creation flow"
        }
      ],
      "files": []
    }
  ]
}
