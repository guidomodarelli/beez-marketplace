{
  "permissions": {
    "allow": [
      "Bash(.agents/hooks/sync-marketplace.sh --provider claude)",
      "Bash(.agents/hooks/check-harness-consistency.sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/sync-marketplace.sh --provider claude",
            "statusMessage": "Sincronizando configuración Agent Ready con marketplace…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/check-harness-consistency.sh",
            "statusMessage": "Verificando consistencia de configuración Agent Ready…"
          }
        ]
      }
    ]
  }
}
