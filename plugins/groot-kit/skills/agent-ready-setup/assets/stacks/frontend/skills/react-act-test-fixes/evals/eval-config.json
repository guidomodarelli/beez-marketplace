        {
          "type": "contains",
          "value": "finally",
          "description": "Restaura ante fallo"
        },
        {
          "type": "contains",
          "value": "jest.useRealTimers",
          "description": "Usa timers reales para axe"
        },
        {
          "type": "contains",
          "value": "axe(container)",
          "description": "Mantiene prueba accesible"
        }
      ]
    },
