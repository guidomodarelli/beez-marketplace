    {
      "id": "spinner-axe",
      "description": "PT: timer de montaje sin estado observable",
      "input": "Confirmamos que spinner Andes real agenda timer de useSrLabel al montar. setup({ loading: true }) retorna container. await axe(container) deixa timer disparar fora de act, sem estado observável para aguardar. Mostre teste corrigido, incluindo try/finally e axe com timers reais. Não execute comandos.",
      "assertions": [
        {
          "type": "contains",
          "value": "jest.useFakeTimers",
          "description": "Controla montaje"
        },
        {
          "type": "contains",
          "value": "act(",
          "description": "Drena dentro de act"
        },
        {
          "type": "contains_any",
