          "description": "Espera act async"
        },
        {
          "type": "contains",
          "value": "await jest.advanceTimersByTimeAsync",
          "description": "Drena trabajo async"
        },
        {
          "type": "contains",
          "value": "jest.useRealTimers",
          "description": "Restaura timers"
        }
      ]
    },
    {
