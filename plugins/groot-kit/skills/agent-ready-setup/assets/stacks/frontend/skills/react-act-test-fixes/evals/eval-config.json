        {
          "type": "contains",
          "value": "await user.click",
          "description": "Espera interacción"
        },
        {
          "type": "contains_any",
          "values": [
            "findByRole",
            "waitFor"
          ],
          "description": "Espera resultado"
        }
      ]
    },
    {
      "id": "async-debounce",
      "description": "PT: debounce con Promise y timers modernos",
      "input": "Teste React com Jest 29.7 e fake timers modernos: debounce de 300 ms aguarda fetch e atualiza estado. act(() => jest.advanceTimersByTime(300)) gera warning. Mostre correção com user-event v14, avanço assíncrono e restauração de timers. Não execute comandos.",
      "assertions": [
        {
          "type": "contains",
          "value": "advanceTimers:",
          "description": "Configura user-event"
