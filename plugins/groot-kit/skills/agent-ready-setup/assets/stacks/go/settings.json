{
  "permissions": {
    "allow": [
      "Bash(.agents/hooks/sync-marketplace.sh --provider claude --sync-instructions --yes)",
      "Bash(.agents/hooks/check-harness-consistency.sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/sync-marketplace.sh --provider claude --sync-instructions --yes"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/check-harness-consistency.sh"
          }
        ]
      }
    ]
  }
}
