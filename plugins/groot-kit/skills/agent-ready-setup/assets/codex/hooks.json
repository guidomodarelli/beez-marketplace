{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/sync-marketplace.sh --provider codex --sync-instructions --yes"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/check-harness-consistency.sh"
          }
        ]
      }
    ]
  }
}
